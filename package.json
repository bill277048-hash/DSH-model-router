{
  "name": "@botton/dsh-model-router",
  "description": "DSH multi-provider model routing plugin: rule-based routing + pre-first-token failover (finish-chunk driven) + cooldown circuit-breaking + usage accounting + a status API. Zero third-party runtime dependencies.",
  "version": "0.7.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bill277048-hash/DSH-model-router.git"
  },
  "homepage": "https://github.com/bill277048-hash/DSH-model-router#readme",
  "bugs": {
    "url": "https://github.com/bill277048-hash/DSH-model-router/issues"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "model-routing",
    "failover",
    "quota",
    "deepseek-harness"
  ],
  "author": "botton指北",
  "license": "Apache-2.0"
}
